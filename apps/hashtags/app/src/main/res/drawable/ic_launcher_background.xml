<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A near-white ground on purpose. Most icons in a store list are dark and
         saturated; a light one reads as a gap and the eye lands on it. The whole
         reason this app is being rebuilt is that nobody tapped it. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="135"
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#F6F1F9" android:offset="0.6" />
                <item android:color="#EADDF0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
