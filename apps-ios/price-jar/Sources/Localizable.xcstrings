    "verdict.notEnoughData %lld": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد سجل كافٍ بعد لإصدار حكم — تم تسجيل %lld سعر حتى الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht genug Verlauf für ein Urteil — bisher %lld erfasster Preis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough history for a verdict yet — %lld price on record so far."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficiente historial para un veredicto: %lld precio registrado hasta ahora."
