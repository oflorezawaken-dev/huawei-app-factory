    "settings.deleteAll.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جميع العناصر والأسعار والمتاجر والقوائم على هذا الآيفون نهائيًا. لا يمكن التراجع عن هذا. اكتب DELETE للتأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht dauerhaft alle Artikel, Preise, Geschäfte und Listen auf diesem iPhone. Dies kann nicht rückgängig gemacht werden. Gib DELETE ein, um zu bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes every item, price, store and list on this iPhone. This cannot be undone. Type DELETE to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todos los artículos, precios, tiendas y listas de este iPhone. No se puede deshacer. Escribe DELETE para confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement tous les articles, prix, magasins et listes sur cet iPhone. Cette action est irréversible. Tapez DELETE pour confirmer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione elimina definitivamente ogni articolo, prezzo, negozio e lista su questo iPhone. Non può essere annullata. Digita DELETE per confermare."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina permanentemente todos os artigos, preços, lojas e listas neste iPhone. Não pode ser desfeito. Escreve DELETE para confirmar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bu iPhone'daki tüm ürünleri, fiyatları, mağazaları ve listeleri kalıcı olarak siler. Bu işlem geri alınamaz. Onaylamak için DELETE yaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将永久删除此iPhone上的所有商品、价格、商店和清单，且无法撤销。请输入DELETE以确认。"
          }
        }
      }
    },
