    "scanner.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الوصول إلى الكاميرا من الإعدادات لمسح الباركود، أو ابحث في دفتر أسعارك بالاسم بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Kamerazugriff in den Einstellungen, um einen Barcode zu scannen, oder suche stattdessen im Preisbuch nach Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on camera access in Settings to scan a barcode, or search your price book by name instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el acceso a la cámara en Ajustes para escanear un código de barras, o busca en tu libro de precios por nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l'accès à l'appareil photo dans Réglages pour scanner un code-barres, ou recherchez dans votre carnet de prix par nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l'accesso alla fotocamera in Impostazioni per scansionare un codice a barre, oppure cerca nel tuo libro dei prezzi per nome."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa o acesso à câmara nas Definições para leres um código de barras, ou pesquisa no teu livro de preços pelo nome."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barkod taramak için Ayarlar'dan kamera erişimini aç, ya da fiyat defterinde isimle ara."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中开启相机权限以扫描条形码，或改为按名称在价格手册中搜索。"
          }
        }
      }
    },
