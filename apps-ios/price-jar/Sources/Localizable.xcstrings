    "firstrun.line1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل ما تدفعه فعليًا، وفي أي متجر، وبأي حجم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse, was du tatsächlich zahlst, in welchem Geschäft, in welcher Größe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record what you actually pay, at which store, in which size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra lo que realmente pagas, en qué tienda y en qué tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ce que vous payez réellement, dans quel magasin, en quelle taille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra quanto paghi davvero, in quale negozio, in quale formato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista o que realmente pagas, em que loja e em que tamanho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçekte ne kadar ödediğini, hangi mağazada ve hangi boyutta olduğunu kaydet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你实际支付的价格、购买的商店以及包装规格。"
          }
        }
      }
    },
    "firstrun.line2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقارنه PriceJar بسجلك الخاص ويخبرك إن كان سعرًا جيدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar vergleicht ihn mit deinem eigenen Verlauf und sagt dir, ob es ein guter Preis ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar compares it to your own history and tells you if it's a good price."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar lo compara con tu propio historial y te dice si es un buen precio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar le compare à votre propre historique et vous dit si c'est un bon prix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar lo confronta con la tua cronologia e ti dice se è un buon prezzo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PriceJar compara com o teu próprio histórico e diz-te se é um bom preço."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar bunu kendi geçmişinle karşılaştırır ve iyi bir fiyat olup olmadığını söyler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar 会将其与你自己的历史记录比较，告诉你这是否是个好价格。"
          }
        }
      }
    },
    "firstrun.line3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى كل شيء على هذا الآيفون — بلا حساب، وبلا مصدر أسعار خارجي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem iPhone — kein Konto, keine externe Preisquelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this iPhone — no account, no price feed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo permanece en este iPhone: sin cuenta, sin fuente de precios externa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet iPhone — pas de compte, pas de flux de prix externe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo iPhone — nessun account, nessun listino esterno."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo permanece neste iPhone — sem conta, sem fonte de preços externa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu iPhone'da kalır — hesap yok, dış fiyat kaynağı yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都保留在此iPhone上——无需账户，也没有外部价格来源。"
          }
        }
      }
    },
