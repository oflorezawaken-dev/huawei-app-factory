    "settings.data.explainer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما تُدخله يبقى على هذا الآيفون. لا يتم رفع أي شيء، ولا يوجد حساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du eingibst, bleibt auf diesem iPhone. Es wird nichts hochgeladen, und es gibt kein Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you enter stays on this iPhone. Nothing is uploaded, and there is no account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que introduces permanece en este iPhone. No se sube nada y no hay cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous saisissez reste sur cet iPhone. Rien n'est envoyé, et il n'y a pas de compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che inserisci resta su questo iPhone. Niente viene caricato online, e non esiste un account."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que introduzes permanece neste iPhone. Nada é enviado, e não existe conta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdiğin her şey bu iPhone'da kalır. Hiçbir şey yüklenmez ve hesap yoktur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你输入的所有内容都保留在此iPhone上，不会上传，也没有账户。"
          }
        }
      }
    },
