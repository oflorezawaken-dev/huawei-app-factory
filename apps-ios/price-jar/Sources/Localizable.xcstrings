        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore assez d'historique pour un verdict — %lld prix enregistré jusqu'ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è ancora abbastanza cronologia per un verdetto — %lld prezzo registrato finora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há histórico suficiente para um veredito — %lld preço registado até agora."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir değerlendirme için yeterli geçmiş yok — şu ana kadar %lld fiyat kaydedildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录尚不足以给出结论——目前已记录 %lld 个价格。"
          }
        }
      }
