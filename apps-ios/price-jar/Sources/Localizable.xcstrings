    "firstrun.barcodeNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتذكر PriceJar العناصر التي تسميها بنفسك. لا يبحث أبدًا عن الباركود عبر الإنترنت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar erinnert sich an die Artikel, die du selbst benennst. Es sucht Barcodes nie online nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar recalls the items you name yourself. It never looks barcodes up online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar recuerda los artículos que tú mismo nombras. Nunca busca códigos de barras en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar retrouve les articles que vous nommez vous-même. Il ne recherche jamais de codes-barres en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar ricorda gli articoli che nomini tu stesso. Non cerca mai i codici a barre online."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PriceJar recorda os artigos que tu próprio nomeias. Nunca procura códigos de barras online."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar, kendi adlandırdığın ürünleri hatırlar. Barkodları asla çevrimiçi aramaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar 只会记住你自己命名的商品，绝不会在线查询条形码。"
          }
        }
      }
    },
