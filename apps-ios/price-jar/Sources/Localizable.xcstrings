    "settings.ads.explainer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق PriceJar مجاني، ويُموَّل عبر الإعلانات في شاشات التصفح. لا تظهر الإعلانات أبدًا أثناء إدخال سعر أو التسوق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar ist kostenlos und wird durch Werbung auf den Browsing-Bildschirmen finanziert. Werbung erscheint nie, während du einen Preis eingibst oder einkaufst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar is free, funded by ads on the browsing screens. Ads never appear while you're entering a price or shopping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar es gratis, financiado por anuncios en las pantallas de navegación. Los anuncios nunca aparecen mientras registras un precio o compras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar est gratuit, financé par des publicités sur les écrans de navigation. Aucune publicité n'apparaît lorsque vous saisissez un prix ou faites vos courses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar è gratuita, finanziata da annunci nelle schermate di navigazione. Gli annunci non appaiono mai mentre inserisci un prezzo o fai la spesa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PriceJar é gratuito, financiado por anúncios nos ecrãs de navegação. Os anúncios nunca aparecem enquanto registas um preço ou fazes compras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar ücretsizdir ve gezinme ekranlarındaki reklamlarla desteklenir. Fiyat girerken veya alışveriş yaparken reklam asla gösterilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PriceJar 是免费的，由浏览页面上的广告提供支持。在输入价格或购物时绝不会出现广告。"
          }
        }
      }
    },
