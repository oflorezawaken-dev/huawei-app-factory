    "removeAds.unlocks.nothing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء. كل عملية حساب وأداة ومشروع وتنسيق تصدير مجاني بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts. Jede Berechnung, jeder Löser, jedes Projekt und Exportformat ist bereits kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing. Every calculation, solver, job and export format is already free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada. Cada cálculo, herramienta, proyecto y formato de exportación ya es gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien. Chaque calcul, outil, chantier et format d'export est déjà gratuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente. Ogni calcolo, strumento, cantiere e formato di esportazione è già gratuito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada. Cada cálculo, ferramenta, projeto e formato de exportação já é gratuito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey. Her hesaplama, araç, iş ve dışa aktarma biçimi zaten ücretsizdir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么都不解锁。每一次计算、每个工具、每个项目和每种导出格式本来就是免费的。"
          }
        }
      }
    },
