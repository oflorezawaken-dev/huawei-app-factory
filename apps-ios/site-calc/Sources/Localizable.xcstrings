    "settings.deleteAll.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف كل مشروع وشريط وقائمة مواد من هذا الآيفون، ولا يمكن التراجع عنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt jedes Projekt, jedes Band und jede Materialliste von diesem iPhone. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes every job, every tape and every material list from this iPhone. It cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina cada proyecto, cinta y lista de materiales de este iPhone. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime tous les chantiers, rubans et listes de matériaux de cet iPhone. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove ogni cantiere, nastro ed elenco materiali da questo iPhone. Non può essere annullato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove todos os projetos, fitas e listas de materiais deste iPhone. Não pode ser desfeito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bu iPhone'daki her işi, her şeridi ve her malzeme listesini kaldırır. Geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除此 iPhone 上的所有项目、纸带和材料清单，且无法撤销。"
          }
        }
      }
    },
