    "stair.statement.yourLimits": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى فارغًا حتى تملأ كليهما. لا يحمل SiteCalc أي قائمة أو درجة خاصة به -- حدودك أنت هي الوحيدة الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer, bis du beide ausgefüllt hast. SiteCalc bringt keine eigene Steigung oder Auftrittstiefe mit -- nur deine eigenen Grenzwerte sind aktuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty until you fill both in. SiteCalc ships no maximum riser or minimum tread of its own -- your own limits are the only current ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacío hasta que rellenes ambos. SiteCalc no trae contrahuella ni huella propias -- tus propios límites son los únicos vigentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide tant que les deux ne sont pas remplis. SiteCalc n'embarque aucune contremarche ni giron -- vos propres limites sont les seules à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoto finché non compili entrambi. SiteCalc non porta alzata o pedata proprie -- i tuoi limiti sono gli unici aggiornati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazio até preencheres os dois. O SiteCalc não traz espelho nem cobertor próprios -- os teus limites são os únicos atuais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkisini de doldurana kadar boş kalır. SiteCalc kendine ait bir rıht veya basamak değeri taşımaz -- güncel olan yalnızca senin sınırlarındır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两项都填写之前保持空白。SiteCalc 不自带任何踢面或踏面数值——只有你自己填写的限值才是最新的。"
          }
        }
      }
    },
