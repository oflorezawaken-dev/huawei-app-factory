    "settings.privacy.explainer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى كل مشروع وشريط وقائمة مواد على هذا الآيفون، ولا يغادر الجهاز شيء يخص أي مشروع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Projekt, Band und jede Materialliste bleibt auf diesem iPhone. Nichts davon verlässt das Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every job, tape and material list stays on this iPhone. Nothing about a job leaves the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada proyecto, cinta y lista de materiales se queda en este iPhone. Nada de un proyecto sale del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque chantier, ruban et liste de matériaux reste sur cet iPhone. Rien d'un chantier n'en sort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni cantiere, nastro ed elenco materiali resta su questo iPhone. Nulla lascia il dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada projeto, fita e lista de materiais fica neste iPhone. Nada de um projeto sai do aparelho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iş, şerit ve malzeme listesi bu iPhone'da kalır. Bir işe dair hiçbir şey cihazdan çıkmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个项目、纸带和材料清单都只保存在这台 iPhone 上，项目内容不会离开设备。"
          }
        }
      }
    },
