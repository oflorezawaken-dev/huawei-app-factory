    "settings.reference.lumber": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأبعاد الاسمية مقابل الفعلية للأخشاب اللينة (مثال: 2×4 يقاس فعليًا 1-1/2 × 3-1/2 بوصة)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenn- gegenüber Istmaß von Nadelholz (z. B. misst ein 2x4 tatsächlich 1-1/2 x 3-1/2 Zoll)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nominal vs actual softwood lumber dimensions (e.g. a 2x4 measures 1-1/2 x 3-1/2 in)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensiones nominales frente a reales de madera blanda (p. ej. un 2x4 mide 1-1/2 x 3-1/2 pulg)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensions nominales et réelles du bois résineux (par ex. un 2x4 mesure 1-1/2 x 3-1/2 po)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensioni nominali contro reali del legname (es. una 2x4 misura 1-1/2 x 3-1/2 poll.)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensões nominais vs reais de madeira macia (p. ex. uma 2x4 mede 1-1/2 x 3-1/2 pol)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nominal ile gerçek yumuşak ahşap ölçüleri (örn. 2x4 aslında 1-1/2 x 3-1/2 inç ölçülür)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标称尺寸与实际软木尺寸对照（例如 2x4 实际为 1-1/2 x 3-1/2 英寸）。"
          }
        }
      }
