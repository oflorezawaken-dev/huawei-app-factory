    "settings.privacy.whyAds": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SiteCalc مجاني ويُموَّل عبر Google AdMob، ولهذا ترى إعلانات في هذه الشاشة وشاشة المشاريع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SiteCalc ist kostenlos und wird durch Google AdMob finanziert, deshalb siehst du hier und bei Projekten Werbung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SiteCalc is free and funded by Google AdMob, which is why you see ads on this screen and the Jobs screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SiteCalc es gratis y se financia con Google AdMob, por eso ves anuncios en esta pantalla y en Proyectos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SiteCalc est gratuite et financée par Google AdMob, c'est pourquoi vous voyez des publicités ici et sur l'écran Chantiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SiteCalc è gratuita e finanziata da Google AdMob, per questo vedi pubblicità qui e nella schermata Cantieri."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O SiteCalc é gratuito e financiado pelo Google AdMob, por isso vês anúncios aqui e em Projetos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SiteCalc ücretsizdir ve Google AdMob tarafından desteklenir; bu yüzden bu ekranda ve İşler ekranında reklam görürsün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SiteCalc 是免费的，由 Google AdMob 提供资金支持，因此你会在此页面和项目页面看到广告。"
          }
        }
      }
    },
