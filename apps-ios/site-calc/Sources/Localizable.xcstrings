    "export.statement.free": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصدير مجاني للأبد ولا يتحقق من أي عملية شراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Export ist für immer kostenlos und prüft keinen Kauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export is free, forever, and checks no purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar es gratis, siempre, y no comprueba ninguna compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'export est gratuit, pour toujours, et ne vérifie aucun achat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esportazione è gratuita, per sempre, e non verifica alcun acquisto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar é grátis, para sempre, e não verifica qualquer compra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarma ücretsizdir, her zaman, ve herhangi bir satın alma kontrolü yapmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出永远免费，且不检查任何购买记录。"
          }
        }
      }
    },
    "firstRun.honestNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى كل شيء على هذا الآيفون. لا حساب. ولا حدود تنظيمية ولا أي وظائف مالية من أي نوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem iPhone. Kein Konto. Keine behördlichen Grenzwerte und keinerlei Geldfunktionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this iPhone. No account. No regulatory limits and no money features of any kind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este iPhone. Sin cuenta. Sin límites reglamentarios ni funciones de dinero de ningún tipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet iPhone. Pas de compte. Aucune limite réglementaire et aucune fonction liée à l'argent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo iPhone. Nessun account. Nessun limite regolamentare e nessuna funzione di denaro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste iPhone. Sem conta. Sem limites regulamentares nem funcionalidades de dinheiro de qualquer tipo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu iPhone'da kalır. Hesap yok. Hiçbir resmi sınır ve hiçbir parasal özellik yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都保存在这台 iPhone 上。无需账户。没有任何法规限值，也没有任何与金钱相关的功能。"
          }
        }
      }
    },
    "firstRun.line1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجرِ حسابات الأقدام والبوصات بدقة تصل إلى 1/64."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechne exakt in Fuß und Zoll, bis auf 1/64."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do feet-and-inch arithmetic, exactly, down to 1/64."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz aritmética de pies y pulgadas, exacta, hasta 1/64."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites de l'arithmétique pieds-pouces, exacte, jusqu'au 1/64."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai calcoli in piedi e pollici, esatti, fino a 1/64."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz aritmética de pés e polegadas, exata, até 1/64."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit ve inç aritmetiğini 1/64'e kadar tam olarak yap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精确进行英尺英寸运算，精度可达1/64。"
          }
        }
      }
    },
    "firstRun.line2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احسب السقف والسلالم."
