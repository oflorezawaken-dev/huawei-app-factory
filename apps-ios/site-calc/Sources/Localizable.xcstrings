    "stair.shortfallStatement": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بناء كل قائمة عند أقرب كسر سيترك نقصًا مقداره %@ عن الارتفاع الكلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Steigung auf die nächste Bruchzahl gebaut, fehlten am Ende %@ von der Gesamthöhe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building every riser at the nearest fraction would fall %@ short of the total rise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construir cada contrahuella con la fracción más cercana quedaría %@ corto respecto a la altura total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construire chaque contremarche à la fraction la plus proche laisserait un manque de %@ par rapport à la hauteur totale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruire ogni alzata alla frazione più vicina lascerebbe uno scarto di %@ rispetto all'altezza totale."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Construir cada espelho na fração mais próxima ficaria %@ aquém da altura total."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her rıhtı en yakın kesre göre yapmak toplam yükseklikten %@ eksik bırakır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果每级踢面都按最接近的分数建造，总升高将短少 %@。"
          }
        }
      }
    },
