    "areaVolume.hint.arc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل نصف القطر ثم الزاوية بالدرجات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radius eingeben, dann den Winkel in Grad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter radius, then the included angle in degrees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce radio y luego el ángulo en grados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le rayon, puis l'angle en degrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci raggio e poi l'angolo in gradi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduz raio e depois o ângulo em graus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarıçapı, ardından açıyı derece cinsinden gir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入半径，再输入圆心角（度）。"
          }
        }
      }
    },
