    "settings.privacy.explainer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى وظائفك وورديتك وإكرامياتك وتقاريرك على هذا الآيفون. الإعلانات وحدها تستخدم الشبكة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Jobs, Schichten, Trinkgelder und Berichte bleiben auf diesem iPhone. Nur die Werbung nutzt das Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your jobs, shifts, tips and reports stay on this iPhone. Only the ads use the network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus empleos, turnos, propinas e informes se quedan en este iPhone. Solo los anuncios usan la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos emplois, services, pourboires et rapports restent sur cet iPhone. Seules les publicités utilisent le réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi lavori, turni, mance e rapporti restano su questo iPhone. Solo gli annunci usano la rete."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus empregos, turnos, gorjetas e relatórios ficam neste iPhone. Só os anúncios usam a rede."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlerin, vardiyaların, bahşişlerin ve raporların bu iPhone'da kalır. Yalnızca reklamlar ağı kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的工作、班次、小费和报告都保存在此 iPhone 上。只有广告会使用网络。"
