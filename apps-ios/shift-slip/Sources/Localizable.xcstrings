    "common.recordsnotadvice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ ShiftSlip بالسجلات ويجري حسابات عليها. لا يقدم أي استشارة ضريبية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip führt Aufzeichnungen und rechnet damit. Es gibt keine Steuerberatung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip keeps records and does arithmetic on them. It gives no tax advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip guarda registros y hace cálculos con ellos. No ofrece asesoría fiscal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip conserve des registres et fait des calculs avec. Il ne donne aucun conseil fiscal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip conserva i tuoi dati e fa i calcoli su di essi. Non fornisce consulenza fiscale."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ShiftSlip guarda registos e faz cálculos com eles. Não dá aconselhamento fiscal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip kayıt tutar ve bunlar üzerinde hesaplama yapar. Vergi danışmanlığı vermez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip 会保存记录并进行运算，但不提供税务建议。"
          }
        }
      }
    },
