    "tipoutsplit.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبَّق النسب المئوية على إجمالي الإكراميات الطوعية أو المبيعات لهذه الوردية، ولا تُطبَّق أبدًا على باقٍ متبقٍ ولا على رسوم الخدمة إلا إذا نصّت القاعدة على خلاف ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozentsätze gelten für die gesamten freiwilligen Trinkgelder oder Umsätze dieser Schicht, nie für einen Restbetrag und nie für Servicegebühren, sofern die Regel nichts anderes vorsieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentages apply to this shift's total voluntary tips or sales, never to a running remainder and never to service charges unless the recipient's rule says otherwise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los porcentajes se aplican al total de propinas voluntarias o ventas de este turno, nunca a un remanente ni a los cargos por servicio salvo que la regla lo indique."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pourcentages s'appliquent au total des pourboires volontaires ou des ventes de ce service, jamais à un solde restant ni aux frais de service, sauf indication contraire de la règle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le percentuali si applicano al totale delle mance volontarie o delle vendite di questo turno, mai a un resto residuo né ai costi di servizio, salvo diversa indicazione della regola."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As percentagens aplicam-se ao total de gorjetas voluntárias ou vendas deste turno, nunca a um remanescente nem a taxas de serviço, salvo indicação da regra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzdeler bu vardiyanın toplam gönüllü bahşişine veya satışına uygulanır; kural aksini belirtmedikçe asla kalan bir bakiyeye veya servis ücretlerine uygulanmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "百分比按本次班次的自愿小费或销售总额计算，绝不基于余额计算，除非该接收人的规则另有说明，也绝不包含服务费。"
          }
        }
      }
    },
