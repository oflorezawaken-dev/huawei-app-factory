    "settings.ads.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق ShiftSlip مجاني، وممول بإعلانات على الشاشات غير الحرجة. لا يظهر أي إعلان أثناء إدخال الوردية أو توزيعها أو الإبلاغ عنها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip ist kostenlos und wird durch Werbung auf unkritischen Bildschirmen finanziert. Beim Erfassen, Aufteilen oder Melden einer Schicht erscheint niemals Werbung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip is free, funded by ads on non-critical screens. No ad ever appears while you enter, split or report a shift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip es gratis, financiado por anuncios en pantallas no críticas. Nunca aparece un anuncio mientras registras, repartes o reportas un turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip est gratuit, financé par des publicités sur des écrans non critiques. Aucune publicité n'apparaît pendant la saisie, la répartition ou le rapport d'un service."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip è gratuita, finanziata da annunci su schermate non critiche. Nessun annuncio appare mentre inserisci, ripartisci o segnali un turno."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ShiftSlip é gratuito, financiado por anúncios em ecrãs não críticos. Nenhum anúncio aparece enquanto regista, reparte ou reporta um turno."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip ücretsizdir ve kritik olmayan ekranlardaki reklamlarla desteklenir. Bir vardiyayı girerken, paylaştırırken veya raporlarken asla reklam görünmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftSlip 是免费应用，由非关键界面上的广告提供支持。在你录入、分配或查看班次报告时绝不会出现广告。"
          }
        }
      }
    },
