    "settings.deleteall.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب DELETE لإزالة كل وظيفة ووردية نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib LÖSCHEN ein, um alle Jobs und Schichten dauerhaft zu entfernen. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type DELETE to permanently remove every job and shift. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe DELETE para eliminar permanentemente todos los empleos y turnos. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez DELETE pour supprimer définitivement tous les emplois et services. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita DELETE per rimuovere definitivamente ogni lavoro e turno. Non può essere annullato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva DELETE para remover permanentemente todos os empregos e turnos. Isto não pode ser anulado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm işleri ve vardiyaları kalıcı olarak kaldırmak için DELETE yaz. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 DELETE 可永久删除所有工作和班次。此操作无法撤销。"
          }
        }
      }
    },
