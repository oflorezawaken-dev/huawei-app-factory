    "settings.privacy.explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your items stay on this device. Only the ads use the network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus elementos se quedan en este dispositivo. Solo los anuncios usan la red."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus itens ficam neste dispositivo. Apenas os anúncios usam a rede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos éléments restent sur cet appareil. Seules les publicités utilisent le réseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einträge bleiben auf diesem Gerät. Nur die Werbung nutzt das Netzwerk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi elementi restano su questo dispositivo. Solo gli annunci usano la rete."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ögelerin bu cihazda kalır. Yalnızca reklamlar ağı kullanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى عناصرك على هذا الجهاز. الإعلانات وحدها تستخدم الشبكة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的条目保存在本机。只有广告会使用网络。"
          }
        }
      }
    },
